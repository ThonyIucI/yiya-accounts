{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "sh ../../scripts/free-port.sh 3011 && wrangler dev --ip 0.0.0.0 --port 3011",
    "deploy:worker": "wrangler deploy",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply streaming-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply streaming-db --remote",
    "db:backup": "wrangler d1 export streaming-db --remote --output backup.sql"
  },
  "dependencies": {
    "@yiya/auth": "workspace:*",
    "@yiya/db": "workspace:*",
    "@yiya/env": "workspace:*",
    "@yiya/shared": "workspace:*",
    "@hono/zod-validator": "^0.7.6",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "uuid": "^14.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "catalog:",
    "@yiya/config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.1"
  }
}
